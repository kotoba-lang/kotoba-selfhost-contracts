;; The KIR interpreter is a RUNTIME dependency: src/ executes the shipped
;; kotoba/*.kir.edn artifacts through it. The compiler (amu) is not — it only
;; produces those artifacts, under :test. That is the split ADR-reliability-t63
;; names: the compiler is a build/analysis tool, the artifact is what runs.
{:paths ["src" "resources"]
 :deps {
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.pprint replaced clojure.pprint here (2026-09-24): the same
        ;; bytes (cljs.pprint transcribed). An explicit floor; tools.deps takes the
        ;; NEWEST sha it is shown.
        io.github.kotoba-lang/pprint {:git/sha "5c9d4aea71d6caac529fffcf361aba0f87ee485e"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/osaho.git"
         ;; must match the kir amu compiled the artifacts with
         :git/sha "d58972da61758584a5bec0e863bcb3ea6fdd6c64"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; amu (the compiler; renamed from kotoba-lang/compiler) is TEST-ONLY.
         ;; It compiles kotoba/safe_analyzer_core.kotoba for the authority test
         ;; and never reaches a consumer of this library — same split as
         ;; ADR-reliability-t63: the compiler is a build/analysis tool, not a
         ;; runtime dependency.
         :override-deps
         {io.github.kotoba-lang/abi
          {:git/url "https://github.com/kotoba-lang/abi.git"
           ;; Must match amu's own abi pin, not amu's commit SHA.
           :git/sha "32ee84b2efc92478c846629c8d8319280eed506c"}}
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       ;; west pin as of 2026-08-11 (#576, native word ops).
                       :git/sha "76d4d9019cf6ecccecc812fca9db8b09fc2d3056"}}
         :main-opts ["-m" "cognitect.test-runner"]}
       ;; Regenerate the shipped KIR from kotoba/*.kotoba. Combine with :test —
       ;; a later alias's :main-opts wins, and this one carries no deps:
       ;;   kbb -M:test:gen
       :gen {:main-opts ["-m" "kotoba.selfhost.oracle-gen"]}
       ;; The same decisions, executed as machine code on this host's ISA.
       ;; Separate from :test because it needs a C toolchain for the measured
       ;; loader and about a minute to compile two modules — a suite you run to
       ;; qualify a change, not while making one.
       ;;
       ;;   kbb -M:test:native            ;; the parity gate
       ;;   kbb -M:test:native-build <dir> ;; just stage a build
       ;;
       ;; tender-native is TEST-ONLY here for the same reason amu is: a
       ;; consumer that runs the interpreter must not inherit a native
       ;; toolchain. `oracle/open-native!` resolves the host at call time, so a
       ;; consumer that does want one adds the dependency itself.
       :native
       {:extra-paths ["test-native"]
        :extra-deps {io.github.kotoba-lang/tender-native
                     {:git/url "https://github.com/kotoba-lang/tender-native.git"
                      ;; ab76044 splits verify-once (`prepare`) from run
                      ;; (`invoke`); before it, every call re-verified the
                      ;; artifact and this suite would have taken hours.
                      ;; 1915ee1 lets a host outside the compiler repo say
                      ;; where the reviewed loader source is.
                      :git/sha "1915ee10a0a2af7edd252e7a0ffd67c0d4c3a167"}}
        :main-opts ["-m" "cognitect.test-runner" "-d" "test-native"]}
       :native-build {:main-opts ["-m" "kotoba.selfhost.native-build"]}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
